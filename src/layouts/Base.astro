---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { langOf, otherLangPath, type Lang } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines */
  noindex?: boolean;
  /** For a page that only exists in one language (e.g. /intercambio, Spanish only) */
  lang?: Lang;
  /** Set to false to leave the site footer off */
  footer?: boolean;
  /** The address search engines should treat as the original (defaults to this page) */
  canonical?: string;
  /** Picture shown when the page is shared (a full URL) */
  image?: string;
  /** 'article' for guides and other written pieces */
  type?: 'website' | 'article';
}

const { title, description = site.description, noindex = false, lang: onlyLang, footer = true, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, site.url).href;
const lang = onlyLang ?? langOf(Astro.url);
const alternate = new URL(otherLangPath(Astro.url), site.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !onlyLang && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alternate} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf6f1" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <!-- Extra tags a page adds, like structured data for search engines -->
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      import.meta.env.PROD && site.goatcounter && (
        <script is:inline async data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {footer && <Footer />}
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
