---
/**
 * The invite window for date ideas. Any element with data-invite="<idea>" opens it with
 * "Hey Val… I'm thinking: <idea>" written out like a text message, ready to send:
 *   - Send: opens WhatsApp with the message filled in; they pick my chat themselves
 *   - Send on insta: copies the message and opens a chat with me on Instagram (Instagram can't
 *     fill in the message, so it's on their clipboard to paste)
 * Nothing is sent from the site and no phone number is in the page.
 * Without JavaScript the window never opens and links with data-invite just go where they point.
 */
import { dateIdeasText } from '@/data/dateIdeas';
import { socials } from '@/data/site';
import { langOf, tr } from '@/i18n';

const lang = langOf(Astro.url);
const t = dateIdeasText.invite;
// ig.me/m/<username> opens a chat with that account, in the app on phones
const instagramUser = socials.find((s) => s.label === 'Instagram')?.href.match(/instagram\.com\/([^/?#]+)/)?.[1];
const instagramChat = instagramUser && `https://ig.me/m/${instagramUser}`;
---

<dialog id="invite-dialog" class="invite" aria-labelledby="invite-title" data-lenis-prevent data-message={tr(t.message, lang)}>
  <button type="button" class="icon-btn absolute top-4 right-4" data-close aria-label={tr(t.close, lang)}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>

  <p id="invite-title" class="eyebrow">{tr(t.title, lang)}</p>

  <!-- The message, drawn as a text bubble -->
  <p class="bubble mt-8" data-invite-message></p>

  <div class="mt-10 flex flex-wrap gap-3">
    <!-- wa.me/?text= has no phone number in it: WhatsApp asks who to send it to -->
    <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-invite-whatsapp>
      {tr(t.send, lang)} <span class="arrow-ne" aria-hidden="true">↗</span>
    </a>
    {
      instagramChat && (
        <a href={instagramChat} target="_blank" rel="noopener noreferrer" class="btn btn-ghost" data-invite-instagram>
          {tr(t.instagram, lang)} <span class="arrow-ne" aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
  <p class="mt-5 text-sm text-muted">{tr(t.note, lang)}</p>
</dialog>

<style>
  .invite {
    width: min(560px, calc(100vw - 2rem));
    max-width: none;
    margin: auto;
    padding: clamp(1.5rem, 5vw, 2.75rem);
    border: 0;
    border-radius: 28px;
    background: var(--color-card);
    color: inherit;
    box-shadow: 0 40px 120px -30px rgb(29 24 32 / 0.35);
  }
  .invite::backdrop {
    background: rgb(248 244 246 / 0.86);
    backdrop-filter: blur(8px);
  }
  .bubble {
    position: relative;
    width: fit-content;
    max-width: 92%;
    padding: 1rem 1.25rem;
    border-radius: 22px 22px 6px 22px;
    margin-left: auto;
    background: var(--color-rose-glow);
    color: white;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.25;
    /* plain wrapping, so the bubble hugs its text like a real message */
    text-wrap: wrap;
    box-shadow: var(--shadow-glow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .invite[open] {
      animation: invite-in 0.6s var(--ease-out-expo);
    }
    .invite[open]::backdrop {
      animation: backdrop-in 0.4s ease-out;
    }
    .invite[open] .bubble {
      animation: bubble-in 0.7s 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
  }
  @keyframes invite-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }
  /* pops up from its tail, like a message arriving */
  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: scale(0.6);
      transform-origin: 100% 100%;
    }
  }
</style>

<script>
  const dialog = document.getElementById('invite-dialog') as HTMLDialogElement;
  const bubble = dialog.querySelector<HTMLElement>('[data-invite-message]')!;
  const whatsapp = dialog.querySelector<HTMLAnchorElement>('[data-invite-whatsapp]')!;
  const instagram = dialog.querySelector<HTMLAnchorElement>('[data-invite-instagram]');
  const lenis = () => (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
  let message = '';
  let opener: HTMLElement | null = null;

  const copyMessage = () => navigator.clipboard?.writeText(message).catch(() => {});

  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-invite]');
    if (!trigger || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    opener = trigger;
    message = dialog.dataset.message!.replace('{idea}', trigger.dataset.invite!);
    bubble.textContent = message;
    whatsapp.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    dialog.showModal();
    lenis()?.stop();
  });

  // The link opens Instagram by itself; copying starts first so the message is ready to paste
  instagram?.addEventListener('click', () => {
    copyMessage();
  });

  dialog.addEventListener('close', () => {
    lenis()?.start();
    opener?.focus({ preventScroll: true });
  });
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
